<script>


/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
    "https://hkrntubzfqnoadpjzawd.supabase.co";


const SUPABASE_KEY =
    "sb_publishable_BcurnqSl_okrPKKO7KOlWQ_awuwRBRU";


const supabaseClient =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY
    );


/* =========================================================
   VARIABLES
========================================================= */

let songs = [];

let currentSong = null;

let artistData = null;


const audio =
    document.getElementById("audio");


const playButton =
    document.getElementById("playButton");


const progress =
    document.getElementById("progress");


/* =========================================================
   TOAST
========================================================= */

function showToast(message){

    const toast =
        document.getElementById("toast");


    toast.textContent = message;


    toast.classList.add("show");


    setTimeout(() => {

        toast.classList.remove("show");

    },3000);

}


/* =========================================================
   STORAGE URL
========================================================= */

function storageUrl(bucket,path){

    if(!path){

        return "";

    }


    /*
       Si Supabase contient déjà une URL complète,
       on la garde.
    */

    if(
        typeof path === "string" &&
        (
            path.startsWith("http://") ||
            path.startsWith("https://")
        )
    ){

        return path;

    }


    return supabaseClient
        .storage
        .from(bucket)
        .getPublicUrl(path)
        .data
        .publicUrl;

}


/* =========================================================
   HTML SECURITY
========================================================= */

function escapeHtml(value){

    return String(value || "")

        .replaceAll("&","&amp;")

        .replaceAll("<","&lt;")

        .replaceAll(">","&gt;")

        .replaceAll('"',"&quot;")

        .replaceAll("'","&#039;");

}


/* =========================================================
   SOCIAL NETWORKS
========================================================= */

function loadSocialLinks(data){

    const container =
        document.getElementById("socialLinks");


    if(!container){

        return;

    }


    /*
       Correspondance avec les colonnes
       de la table artist dans Supabase.
    */

    const networks = [

        {
            key:"facebook_url",
            name:"Facebook",
            icon:"fa-brands fa-facebook-f"
        },

        {
            key:"instagram_url",
            name:"Instagram",
            icon:"fa-brands fa-instagram"
        },

        {
            key:"tiktok_url",
            name:"TikTok",
            icon:"fa-brands fa-tiktok"
        },

        {
            key:"youtube_url",
            name:"YouTube",
            icon:"fa-brands fa-youtube"
        },

        {
            key:"x_url",
            name:"X",
            icon:"fa-brands fa-x-twitter"
        },

        {
            key:"audiomack_url",
            name:"Audiomack",
            icon:"fa-brands fa-audiomack"
        },

        {
            key:"whatsapp_url",
            name:"WhatsApp",
            icon:"fa-brands fa-whatsapp"
        }

    ];


    /*
       On garde uniquement les réseaux
       dont le lien existe.
    */

    const available =
        networks.filter(network => {

            const url =
                data?.[network.key];


            return (
                typeof url === "string" &&
                url.trim() !== ""
            );

        });


    /*
       Aucun réseau configuré.
    */

    if(!available.length){

        container.innerHTML = `

            <div class="empty">

                Aucun réseau social disponible.

            </div>

        `;

        return;

    }


    container.innerHTML = "";


    /*
       Création des boutons automatiquement.
    */

    available.forEach(network => {

        const url =
            data[network.key].trim();


        const link =
            document.createElement("a");


        link.className =
            "social-link";


        link.href =
            url;


        link.target =
            "_blank";


        link.rel =
            "noopener noreferrer";


        link.setAttribute(
            "aria-label",
            network.name
        );


        link.innerHTML = `

            <i class="${network.icon}"></i>

            <span class="social-name">

                ${escapeHtml(network.name)}

            </span>

        `;


        container.appendChild(link);

    });

}


/* =========================================================
   ARTIST
========================================================= */

async function loadArtist(){

    const {
        data,
        error
    } =
        await supabaseClient
        .from("artist")
        .select("*")
        .limit(1)
        .maybeSingle();


    if(error){

        console.error(
            "Erreur artiste:",
            error
        );


        document.getElementById("artistBio")
            .textContent =
            "Impossible de charger les informations.";


        const socialContainer =
            document.getElementById("socialLinks");


        if(socialContainer){

            socialContainer.innerHTML = `

                <div class="empty">

                    Impossible de charger les réseaux.

                </div>

            `;

        }


        return null;

    }


    if(!data){

        const socialContainer =
            document.getElementById("socialLinks");


        if(socialContainer){

            socialContainer.innerHTML = `

                <div class="empty">

                    Aucun profil artiste disponible.

                </div>

            `;

        }


        return null;

    }


    /*
       On conserve toutes les données de l'artiste.
    */

    artistData = data;


    const name =
        data.stage_name ||
        "Tiga Disiel";


    const bio =
        data.biography ||
        "Artiste congolais.";


    document.getElementById("artistName")
        .textContent = name;


    document.getElementById("artistName2")
        .textContent = name;


    document.getElementById("artistBio")
        .textContent = bio;


    document.getElementById("fullBio")
        .textContent = bio;


    /* =====================================================
       RÉSEAUX SOCIAUX

       Les liens viennent directement de Supabase.
    ====================================================== */

    loadSocialLinks(data);


    /*
       Photo de l'artiste.

       photo_url peut contenir :

       FB_IMG_1791295998438.jpg

       donc on construit automatiquement
       l'URL du bucket covers.
    */

    if(data.photo_url){

        const photoUrl =
            storageUrl(
                "covers",
                data.photo_url
            );


        document.getElementById("artistPhoto")
            .src = photoUrl;


        document.getElementById("artistPhoto2")
            .src = photoUrl;


        document.getElementById("splashPhoto")
            .src = photoUrl;

    }


    return data;

}


/* =========================================================
   SONGS
========================================================= */

async function loadSongs(){

    const {
        data,
        error
    } =
        await supabaseClient
        .from("songs")
        .select(`
            id,
            title,
            cover_path,
            audio_path,
            duration_seconds,
            downloadable,
            play_count,
            release_date,
            published
        `)
        .eq("published",true)
        .order(
            "release_date",
            {
                ascending:false
            }
        );


    if(error){

        console.error(
            "Erreur musiques:",
            error
        );


        document.getElementById("latestSongs")
            .innerHTML = `

                <div class="empty">

                    Impossible de charger les musiques.

                </div>

            `;

        return;

    }


    /*
       On garde les données Supabase intactes.

       On supprime seulement les doublons
       visuellement dans l'application.
    */

    const uniqueSongs = [];


    const titles = new Set();


    (data || []).forEach(song => {

        const key =
            String(song.title || "")
                .trim()
                .toLowerCase();


        if(!titles.has(key)){

            titles.add(key);

            uniqueSongs.push(song);

        }

    });


    songs = uniqueSongs;


    renderSongs(
        songs.slice(0,5),
        "latestSongs"
    );


    renderSongs(
        songs,
        "allSongs"
    );

}


/* =========================================================
   DISPLAY SONGS
========================================================= */

function renderSongs(
    list,
    containerId
){

    const container =
        document.getElementById(containerId);


    if(!list.length){

        container.innerHTML = `

            <div class="empty">

                Aucune musique disponible.

            </div>

        `;

        return;

    }


    container.innerHTML = "";


    list.forEach(song => {


        const cover =
            storageUrl(
                "covers",
                song.cover_path
            );


        const item =
            document.createElement("div");


        item.className = "song";


        item.innerHTML = `

            <img
                class="cover"
                src="${cover}"
                alt="Pochette"
                onerror="this.style.visibility='hidden'"
            >


            <div class="song-info">


                <div class="song-title">

                    ${escapeHtml(song.title)}

                </div>


                <div class="song-meta">

                    ${Number(song.play_count || 0)}
                    écoutes

                </div>


            </div>


            <div class="actions">


                <button
                    class="action play"
                    data-play="${String(song.id)}"
                    aria-label="Lire">

                    <i class="fa-solid fa-play"></i>

                </button>


                ${
                    song.downloadable
                    ?
                    `

                    <button
                        class="action"
                        data-download="${String(song.id)}"
                        aria-label="Télécharger">

                        <i class="fa-solid fa-download"></i>

                    </button>

                    `
                    :
                    ""
                }


            </div>

        `;


        container.appendChild(item);

    });


    /*
       On compare les IDs en String.

       Supabase peut retourner un nombre,
       tandis que dataset retourne une chaîne.
    */

    container
        .querySelectorAll("[data-play]")
        .forEach(button => {


            button.addEventListener(
                "click",
                function(){

                    const id =
                        String(
                            this.dataset.play
                        );


                    const song =
                        songs.find(
                            s =>
                            String(s.id) === id
                        );


                    if(song){

                        playSong(song);

                    }

                }
            );

        });


    container
        .querySelectorAll("[data-download]")
        .forEach(button => {


            button.addEventListener(
                "click",
                function(){

                    const id =
                        String(
                            this.dataset.download
                        );


                    const song =
                        songs.find(
                            s =>
                            String(s.id) === id
                        );


                    if(song){

                        downloadSong(song);

                    }

                }
            );

        });

}


/* =========================================================
   PLAY SONG
========================================================= */

async function playSong(song){

    if(!song){

        return;

    }


    const url =
        storageUrl(
            "music",
            song.audio_path
        );


    if(!url){

        showToast(
            "Fichier audio introuvable."
        );

        return;

    }


    console.log(
        "Audio URL:",
        url
    );


    currentSong = song;


    document.getElementById("playerTitle")
        .textContent =
        song.title;


    document.getElementById("playerStatus")
        .textContent =
        "Tiga Disiel";


    const cover =
        storageUrl(
            "covers",
            song.cover_path
        );


    if(cover){

        document.getElementById("playerCover")
            .src = cover;

    }


    /*
       On remet la position au début.
    */

    audio.pause();

    audio.currentTime = 0;

    audio.src = url;

    audio.load();


    progress.value = 0;


    try{

        await audio.play();


        updatePlayButton(true);


        /*
           Enregistrement de l'écoute.
        */

        const {
            error: playError
        } =
            await supabaseClient
            .from("plays")
            .insert({
                song_id:song.id
            });


        if(playError){

            console.warn(
                "Écoute non enregistrée:",
                playError
            );

        }

    }
    catch(error){

        console.error(
            "Erreur lecture audio:",
            error
        );


        updatePlayButton(false);


        showToast(
            "Impossible de lire cette musique. Vérifie que le fichier audio est public dans le bucket music."
        );

    }

}


/* =========================================================
   PLAY BUTTON
========================================================= */

function updatePlayButton(isPlaying){

    if(isPlaying){

        playButton.innerHTML =
            '<i class="fa-solid fa-pause"></i>';

    }
    else{

        playButton.innerHTML =
            '<i class="fa-solid fa-play"></i>';

    }

}


/* =========================================================
   PLAYER PLAY / PAUSE
========================================================= */

playButton.addEventListener(
    "click",
    async function(){

        if(!currentSong){

            showToast(
                "Sélectionne d'abord une musique."
            );

            return;

        }


        try{

            if(audio.paused){

                await audio.play();

                updatePlayButton(true);

            }
            else{

                audio.pause();

                updatePlayButton(false);

            }

        }
        catch(error){

            console.error(error);

            showToast(
                "La lecture audio a échoué."
            );

        }

    }
);


/* =========================================================
   AUDIO EVENTS
========================================================= */

audio.addEventListener(
    "timeupdate",
    function(){

        if(
            !audio.duration ||
            !Number.isFinite(audio.duration)
        ){

            return;

        }


        progress.value =
            (
                audio.currentTime /
                audio.duration
            ) * 100;

    }
);


audio.addEventListener(
    "loadedmetadata",
    function(){

        progress.value = 0;

    }
);


audio.addEventListener(
    "play",
    function(){

        updatePlayButton(true);

    }
);


audio.addEventListener(
    "pause",
    function(){

        updatePlayButton(false);

    }
);


audio.addEventListener(
    "ended",
    function(){

        updatePlayButton(false);

        progress.value = 0;

    }
);


audio.addEventListener(
    "error",
    function(){

        console.error(
            "Erreur HTML Audio:",
            audio.error
        );


        updatePlayButton(false);

        showToast(
            "Le fichier audio ne peut pas être lu."
        );

    }
);


/* =========================================================
   PROGRESS
========================================================= */

progress.addEventListener(
    "input",
    function(){

        if(
            audio.duration &&
            Number.isFinite(audio.duration)
        ){

            audio.currentTime =
                (
                    Number(this.value) /
                    100
                ) *
                audio.duration;

        }

    }
);


/* =========================================================
   DOWNLOAD
========================================================= */

async function downloadSong(song){

    if(!song.downloadable){

        return;

    }


    const url =
        storageUrl(
            "music",
            song.audio_path
        );


    if(!url){

        showToast(
            "Fichier audio introuvable."
        );

        return;

    }


    const {
        error
    } =
        await supabaseClient
        .from("downloads")
        .insert({
            song_id:song.id
        });


    if(error){

        console.warn(
            "Téléchargement non enregistré:",
            error
        );

    }


    /*
       Téléchargement direct.
    */

    const link =
        document.createElement("a");


    link.href = url;


    link.download =
        (song.title || "tiga-disiel")
        .replace(
            /[^a-z0-9\- ]/gi,
            ""
        )
        .trim()
        + ".mp3";


    link.target = "_blank";


    link.rel =
        "noopener noreferrer";


    document.body.appendChild(link);


    link.click();


    link.remove();

}


/* =========================================================
   VIDEOS
========================================================= */

async function loadVideos(){

    const container =
        document.getElementById("videosList");


    const {
        data,
        error
    } =
        await supabaseClient
        .from("videos")
        .select("*")
        .eq("published",true)
        .order(
            "created_at",
            {
                ascending:false
            }
        );


    if(error){

        console.error(
            "Erreur vidéos:",
            error
        );


        container.innerHTML = `

            <div class="empty">

                Impossible de charger les clips.

            </div>

        `;

        return;

    }


    if(!data || !data.length){

        container.innerHTML = `

            <div class="empty">

                Aucun clip disponible.

            </div>

        `;

        return;

    }


    container.innerHTML = "";


    data.forEach(video => {


        let thumbnail = "";


        if(video.thumbnail_path){

            thumbnail =
                storageUrl(
                    "covers",
                    video.thumbnail_path
                );

        }


        const item =
            document.createElement("div");


        item.className =
            "song video-item";


        item.innerHTML = `


            ${
                thumbnail
                ?
                `

                <img
                    class="cover"
                    src="${thumbnail}"
                    alt="Clip"
                >

                `
                :
                `
                <div
                    class="cover"
                    style="
                        display:flex;
                        align-items:center;
                        justify-content:center
                    "
                >

                    <i class="fa-solid fa-video"></i>

                </div>
                `
            }


            <div class="song-info">


                <div class="song-title">

                    ${escapeHtml(video.title)}

                </div>


                <div class="song-meta">

                    Clip officiel

                </div>


            </div>


            <div class="actions">


                ${
                    video.video_url
                    ?
                    `

                    <button
                        class="action play"
                        data-video="${escapeHtml(video.video_url)}"
                        aria-label="Voir le clip">

                        <i class="fa-solid fa-play"></i>

                    </button>

                    `
                    :
                    ""
                }


            </div>

        `;


        container.appendChild(item);

    });


    container
        .querySelectorAll("[data-video]")
        .forEach(button => {


            button.addEventListener(
                "click",
                function(){

                    window.open(
                        this.dataset.video,
                        "_blank",
                        "noopener,noreferrer"
                    );

                }
            );

        });

}


/* =========================================================
   NAVIGATION
========================================================= */

document
    .querySelectorAll(".nav button")
    .forEach(button => {


        button.addEventListener(
            "click",
            async function(){


                document
                    .querySelectorAll(".nav button")
                    .forEach(btn =>
                        btn.classList.remove(
                            "active"
                        )
                    );


                this.classList.add("active");


                const page =
                    this.dataset.page;


                document.getElementById("homePage")
                    .style.display =
                    page === "home"
                    ? "block"
                    : "none";


                document.getElementById("musicPage")
                    .style.display =
                    page === "music"
                    ? "block"
                    : "none";


                document.getElementById("videosPage")
                    .style.display =
                    page === "videos"
                    ? "block"
                    : "none";


                document.getElementById("artistPage")
                    .style.display =
                    page === "artist"
                    ? "block"
                    : "none";


                if(page === "videos"){

                    await loadVideos();

                }

            }
        );

    });


/* =========================================================
   REFRESH
========================================================= */

document
    .getElementById("refreshBtn")
    .addEventListener(
        "click",
        async function(){

            this.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin"></i>';


            await loadArtist();


            await loadSongs();


            await loadVideos();


            this.innerHTML =
                '<i class="fa-solid fa-rotate"></i>';

        }
    );


/* =========================================================
   SPLASH
========================================================= */

function closeSplash(){

    const splash =
        document.getElementById(
            "splashScreen"
        );


    setTimeout(
        () => {

            splash.classList.add("hide");

        },
        2200
    );

}


/* =========================================================
   INITIALISATION
========================================================= */

async function init(){

    try{

        /*
           On charge l'artiste en premier afin que
           sa photo puisse apparaître dans le splash.
        */

        await loadArtist();


        await loadSongs();


        closeSplash();

    }
    catch(error){

        console.error(
            "Erreur initialisation:",
            error
        );


        closeSplash();

    }

}


init();

</script>

