<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#090b10;
    --surface:#11151d;
    --surface2:#181d27;
    --border:#272d38;
    --text:#ffffff;
    --muted:#8e97a6;
    --gold:#d9a441;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Arial,Helvetica,sans-serif;
    min-height:100vh;
    padding-bottom:110px;
}

button{
    font-family:inherit;
}

/* =========================================================
   SPLASH SCREEN
========================================================= */

#splashScreen{

    position:fixed;

    inset:0;

    z-index:9999;

    background:#090b10;

    display:flex;

    align-items:center;

    justify-content:center;

    overflow:hidden;

    transition:
        opacity .7s ease,
        visibility .7s ease;
}

#splashScreen.hide{

    opacity:0;

    visibility:hidden;

    pointer-events:none;
}

.splash-content{

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    text-align:center;

    animation:splashEnter 1.2s ease forwards;
}

.splash-photo{

    width:145px;

    height:145px;

    border-radius:50%;

    object-fit:cover;

    border:3px solid var(--gold);

    background:var(--surface);

    box-shadow:
        0 0 0 8px rgba(217,164,65,.08),
        0 15px 50px rgba(0,0,0,.5);

    animation:
        photoAppear 1.1s ease forwards,
        photoFloat 3s ease-in-out 1.2s infinite;
}

.splash-name{

    margin-top:22px;

    font-size:32px;

    font-weight:900;

    letter-spacing:1px;

    opacity:0;

    animation:nameAppear .8s ease .5s forwards;
}

.splash-name span{

    color:var(--gold);

}

.splash-line{

    width:0;

    height:3px;

    margin-top:14px;

    border-radius:10px;

    background:var(--gold);

    animation:lineAppear .8s ease 1s forwards;
}

@keyframes splashEnter{

    from{
        transform:scale(.94);
        opacity:0;
    }

    to{
        transform:scale(1);
        opacity:1;
    }

}

@keyframes photoAppear{

    from{
        transform:scale(.5);
        opacity:0;
    }

    to{
        transform:scale(1);
        opacity:1;
    }

}

@keyframes photoFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-7px);
    }

}

@keyframes nameAppear{

    from{
        transform:translateY(15px);
        opacity:0;
    }

    to{
        transform:translateY(0);
        opacity:1;
    }

}

@keyframes lineAppear{

    from{
        width:0;
    }

    to{
        width:90px;
    }

}


/* =========================================================
   HEADER
========================================================= */

.header{

    position:sticky;

    top:0;

    z-index:50;

    background:rgba(9,11,16,.96);

    border-bottom:1px solid var(--border);

    padding:16px;
}

.header-inner{

    max-width:900px;

    margin:auto;

    display:flex;

    align-items:center;

    justify-content:space-between;
}

.logo{

    font-size:20px;

    font-weight:800;

    letter-spacing:.4px;
}

.logo span{

    color:var(--gold);

}

.refresh{

    width:42px;

    height:42px;

    border-radius:50%;

    background:var(--surface);

    color:white;

    border:1px solid var(--border);

    cursor:pointer;

    font-size:16px;

}

.refresh:active{

    transform:scale(.92);

}


/* =========================================================
   MAIN
========================================================= */

main{

    max-width:900px;

    margin:auto;

    padding:18px 16px;
}


/* =========================================================
   NAVIGATION
========================================================= */

.nav{

    display:flex;

    gap:8px;

    overflow-x:auto;

    scrollbar-width:none;

    margin-bottom:20px;
}

.nav::-webkit-scrollbar{

    display:none;

}

.nav button{

    flex-shrink:0;

    padding:10px 17px;

    border-radius:30px;

    border:1px solid var(--border);

    background:var(--surface);

    color:white;

    cursor:pointer;

}

.nav button.active{

    background:var(--gold);

    border-color:var(--gold);

    color:#111;

}


/* =========================================================
   HERO
========================================================= */

.hero{

    border:1px solid var(--border);

    border-radius:24px;

    padding:22px;

    background:
        linear-gradient(
            135deg,
            rgba(217,164,65,.2),
            rgba(17,21,29,.95)
        );

    margin-bottom:25px;
}

.hero-content{

    display:flex;

    gap:18px;

    align-items:center;
}

.artist-photo{

    width:115px;

    height:115px;

    border-radius:20px;

    object-fit:cover;

    background:var(--surface2);

    border:1px solid var(--border);

}

.hero h1{

    font-size:29px;

    margin-bottom:7px;

}

.hero p{

    color:var(--muted);

    line-height:1.55;

}


/* =========================================================
   SECTIONS
========================================================= */

.section{

    margin-top:25px;

}

.section-title{

    margin-bottom:14px;

}

.section-title h2{

    font-size:21px;

}


/* =========================================================
   SONGS
========================================================= */

.song-list{

    display:flex;

    flex-direction:column;

    gap:10px;

}

.song{

    display:flex;

    align-items:center;

    gap:12px;

    background:var(--surface);

    border:1px solid var(--border);

    border-radius:17px;

    padding:11px;

}

.cover{

    width:62px;

    height:62px;

    border-radius:12px;

    object-fit:cover;

    background:var(--surface2);

    flex-shrink:0;

}

.song-info{

    flex:1;

    min-width:0;

}

.song-title{

    font-weight:700;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;

}

.song-meta{

    color:var(--muted);

    font-size:13px;

    margin-top:5px;

}

.actions{

    display:flex;

    gap:7px;

}

.action{

    width:40px;

    height:40px;

    border-radius:50%;

    border:1px solid var(--border);

    background:var(--surface2);

    color:white;

    cursor:pointer;

    font-size:15px;

    display:flex;

    align-items:center;

    justify-content:center;

}

.action:active{

    transform:scale(.91);

}

.action.play{

    background:var(--gold);

    color:#111;

    border-color:var(--gold);

}


/* =========================================================
   EMPTY / LOADING
========================================================= */

.empty{

    padding:30px 15px;

    text-align:center;

    color:var(--muted);

    border:1px dashed var(--border);

    border-radius:16px;

}

.loading{

    padding:30px;

    text-align:center;

    color:var(--muted);

}


/* =========================================================
   ABOUT
========================================================= */

.about{

    background:var(--surface);

    border:1px solid var(--border);

    border-radius:20px;

    padding:20px;

    line-height:1.7;

    color:var(--muted);

}


/* =========================================================
   SOCIAL NETWORKS
========================================================= */

.social-section{

    margin-top:25px;

}

.social-links{

    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(140px,1fr)
        );

    gap:10px;

}

.social-link{

    display:flex;

    align-items:center;

    gap:11px;

    min-width:0;

    padding:14px;

    background:var(--surface);

    border:1px solid var(--border);

    border-radius:15px;

    color:white;

    text-decoration:none;

    transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
}

.social-link:hover{

    border-color:var(--gold);

    background:var(--surface2);

    transform:translateY(-2px);

}

.social-link:active{

    transform:scale(.97);

}

.social-link i{

    width:23px;

    min-width:23px;

    text-align:center;

    font-size:19px;

}

.social-name{

    font-size:13px;

    font-weight:700;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;

}

.loading-social{

    grid-column:1/-1;

    padding:20px;

    text-align:center;

    color:var(--muted);

}


/* =========================================================
   VIDEO
========================================================= */

.video-item{

    cursor:pointer;

}

.video-item:active{

    transform:scale(.99);

}


/* =========================================================
   PLAYER
========================================================= */

.player{

    position:fixed;

    z-index:100;

    left:0;

    right:0;

    bottom:0;

    background:#0d1119;

    border-top:1px solid var(--border);

    padding:11px 15px;

}

.player-inner{

    max-width:900px;

    margin:auto;

}

.player-top{

    display:flex;

    align-items:center;

    gap:11px;

}

.player-cover{

    width:50px;

    height:50px;

    object-fit:cover;

    border-radius:10px;

    background:var(--surface2);

}

.player-info{

    flex:1;

    min-width:0;

}

.player-title{

    font-size:14px;

    font-weight:700;

    overflow:hidden;

    white-space:nowrap;

    text-overflow:ellipsis;

}

.player-status{

    color:var(--muted);

    font-size:12px;

    margin-top:3px;

}

.player-button{

    width:44px;

    height:44px;

    border-radius:50%;

    border:0;

    background:var(--gold);

    color:#111;

    cursor:pointer;

    display:flex;

    align-items:center;

    justify-content:center;

}

.player-button:active{

    transform:scale(.92);

}

.progress{

    width:100%;

    margin-top:8px;

    accent-color:var(--gold);

}

audio{

    display:none;

}


/* =========================================================
   TOAST
========================================================= */

#toast{

    position:fixed;

    left:50%;

    bottom:120px;

    transform:
        translateX(-50%)
        translateY(20px);

    background:#181d27;

    border:1px solid var(--border);

    color:white;

    padding:11px 16px;

    border-radius:12px;

    font-size:13px;

    opacity:0;

    pointer-events:none;

    transition:.3s ease;

    z-index:500;

    max-width:90%;

    text-align:center;

}

#toast.show{

    opacity:1;

    transform:
        translateX(-50%)
        translateY(0);

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    main{

